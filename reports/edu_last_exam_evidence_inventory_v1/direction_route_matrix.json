{
  "schema_version": "edu_last_exam_evidence_route_matrix_v1",
  "status": "working_matrix",
  "purpose": "把37个方向的原始任务、逐题结果、文献机制、环境和评分条件分开记录；候选来源不等于已证明的AI难题。",
  "route_definitions": {
    "reuse_original": {
      "meaning": "有可追溯原题或公开示例，尽量保留原输入、任务、评分和环境。",
      "promotion_gate": "source/task contract + gold/rubric audit + control + held-out model + required human/artifact check"
    },
    "benchmark_adaptation": {
      "meaning": "有相邻benchmark可提供候选或协议，但需要改编到教育构念并明确改编边界。",
      "promotion_gate": "benchmark validity audit + construct-fit review + neutral/control pair + held-out model"
    },
    "mechanism_authored": {
      "meaning": "没有可直接复用原题，依据论文中明确失败条件自建；不得冒充论文原题。",
      "promotion_gate": "paper locator + condition mapping + author offline check + independent rubric/human review + held-out model"
    },
    "blocked": {
      "meaning": "缺原始人类难度、真实工具、长期状态、媒体或协议，不能用弱代理填空。",
      "promotion_gate": "补齐缺口后再进入候选；当前只记录设计和阻塞原因"
    }
  },
