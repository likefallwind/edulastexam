      "wrong_unit": {
        "actions": {
          "explain": {
            "observation": "学生：应该是5段，不是5米；我按你提醒改好了。",
            "next_state": "prepared"
          },
          "finish": {
            "observation": "教师记录：单位问题未修复。",
            "next_state": "done"
          }
        }
      },
      "transfer_ok": {
        "actions": {
          "finish": {
            "observation": "教师记录：保存了本轮学生独立迁移和解释证据。",
            "next_state": "done"
          },
          "explain": {
            "observation": "学生：我已经解释过了，还有一个新的检查目标吗？",
            "next_state": "transfer_ok"
          }
        }
      }
    },
    "terminal_states": [
      "done"
    ]
